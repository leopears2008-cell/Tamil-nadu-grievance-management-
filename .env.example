# Server-only secrets
GEMINI_API_KEY=

# Firebase Admin SDK service account JSON. Used only to verify Firebase Auth ID tokens.
# Never expose this value to Vite/client code.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Comma-separated allowlist for server-side admin API authorization.
ADMIN_EMAILS=

# Supabase server configuration. SUPABASE_SERVICE_ROLE_KEY is server-only.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated production frontend origins allowed to call the backend.
CORS_ORIGINS=https://your-app.vercel.app

# Public backend API base URL used by the Vercel frontend.
VITE_API_URL=https://your-backend.example.com

# Firebase Authentication client configuration (Firebase Auth is intentionally retained).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Supabase browser configuration is only needed if a future frontend feature
# uses the Supabase client directly. Never put the service-role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Production hardening (server-only)
PUBLIC_API_URL=https://your-backend.example.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
GRIEVANCE_STORAGE_BUCKET=grievance-evidence
CLAMAV_SCAN_URL=
OBSERVABILITY_WEBHOOK_URL=
NEWS_PROVIDER=newsapi
NEWS_API_KEY=
